# REQUIRED Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# REQUIRED OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# REQUIRED for testing transfers and calls (your personal phone number or dummy number)
ALEX_PHONE_NUMBER=your_phone_number_here

# Database (SQLite for local dev)
DATABASE_URL=sqlite:///./career_flow.db

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional (for old integrations - not needed)
DEEPGRAM_API_KEY=your_deepgram_key_if_needed
ELEVENLABS_API_KEY=your_elevenlabs_key_if_needed

